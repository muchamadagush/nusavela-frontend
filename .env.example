# URL publik API Rust. API harus mengizinkan origin web melalui CORS.
VITE_API_URL=http://localhost:8080
# Tile raster milik sendiri atau provider berlisensi. Tidak ada default server publik OSM.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
# Production SSR runtime only; do not prefix with VITE_.
# Browser still uses the publicly reachable VITE_API_URL baked during build.
RUST_API_URL=http://localhost:8080
PUBLIC_ORIGIN=https://nusavela.com
PORT=3000

# Effortless Programmatic Monetization Partner IDs (Optional — works automatically with defaults)
VITE_STAY22_AID=nusavela
VITE_TRAVELPAYOUTS_MARKER=595834
